{
  "name": "loto-numeros-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/run-tests.js src",
    "backup": "node scripts/backup-db.js",
    "migrate": "node scripts/migrate.js",
    "test:api": "node scripts/run-tests.js test --serial",
    "test:all": "npm test && npm run test:api",
    "lint": "eslint src scripts test",
    "restore": "node scripts/restore-db.js",
    "db:setup": "node scripts/setup-db.js",
    "db:sql": "node scripts/export-setup-sql.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "nodemailer": "^10.0.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
