PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=loto_numeros

JWT_SECRET=cambia-esta-clave
JWT_EXPIRES_IN=8h

# Fuente de resultados (opcional, estos son los valores por defecto)
LOTTO_API_URL=https://loto.hn/api/resultados_superpremio_por_fecha.php
LOTTO_TIMEOUT_MS=10000

# true = el servidor busca solo los resultados nuevos después de cada sorteo
SYNC_AUTO=false

# Cuántos proxies hay delante del servidor (nginx = 1). Déjalo en 0 si no hay ninguno.
TRUST_PROXY=0

# Correo para recuperar contraseñas (opcional). Sin SMTP_HOST la recuperación queda desactivada.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Loto Números <no-responder@tudominio.com>
