# Copia este archivo a .env (junto a docker-compose.yml) y cambia TODOS los valores.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_PASSWORD=cambia-esta-clave-de-la-app
# 32+ caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL pública desde la que se abre el sistema
FRONTEND_URL=http://localhost:8080
SYNC_AUTO=true
# Correo para recuperar contraseñas (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
